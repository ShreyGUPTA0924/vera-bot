# Copy to .env for local runs. On Render, set these as Environment Variables.
# Never commit real keys.

# Master switch for the LLM polish layer (0 = templates only)
LLM_ENABLED=1

# Primary: Google Gemini (free tier). Use the exact model id your key lists:
#   python eval/llm_check.py   -> prints the models your key can use
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# auto-detected if -1; llm_check.py prints the right value
GEMINI_VARIANT=-1
# which provider goes first
LLM_ORDER=gemini,groq
# Free-tier budget (set ~20% under the published limits)
GEMINI_RPM=8
GEMINI_RPD=400
GEMINI_TPM=200000

# Failover: Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_RPM=24
GROQ_RPD=800
GROQ_TPM=6400

# Deadlines (seconds)
TICK_DEADLINE=10
REPLY_DEADLINE=8
LLM_CALL_TIMEOUT=6

# Identity for /v1/metadata
TEAM_NAME=Shrey Gupta
TEAM_MEMBERS=Shrey Gupta
CONTACT_EMAIL=shreygupta0924@gmail.com
